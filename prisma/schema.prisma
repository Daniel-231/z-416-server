// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  authId String @unique
  email String @unique
  authProvider AuthProvider
  username String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  friendshipsInitiated Friendship[] @relation("Requester")
  friendshipsReceived  Friendship[] @relation("Addressee")
  locationSharesRequested LocationShare[] @relation("ShareRequester")
  locationSharesShared    LocationShare[] @relation("ShareSharer")
}

enum AuthProvider {
  EMAIL
}

model Friendship {
  id String @id @default(uuid())
  requesterId String
  addresseeId String
  status FriendshipStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id])
  addressee User @relation("Addressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}


model LocationShare {
  id          String   @id @default(uuid())
  requesterId String   // wants to see
  sharerId    String   // being tracked
  status      LocationShareStatus @default(REQUESTED)
  createdAt   DateTime @default(now())
  endedAt     DateTime?

  requester User @relation("ShareRequester", fields: [requesterId], references: [id])
  sharer    User @relation("ShareSharer",    fields: [sharerId],    references: [id])
}

enum LocationShareStatus {
  REQUESTED
  ACTIVE
  ENDED
  DECLINED
}