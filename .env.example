# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# Server
PORT=5000

# Database — used by Prisma Client at runtime (src/lib/prisma.ts).
# Pooled connection. On Supabase: pgbouncer pooler, port 6543, ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Database — used by the Prisma CLI only (migrate / studio / db pull) via prisma.config.ts.
# Direct / session connection. On Supabase: port 5432
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth — server-side (src/lib/supabase.ts)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Not read by any code yet — kept for reference / future use. Safe to leave blank.
SUPABASE_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_CLIENT_ID=
SUPABASE_AUTH_SECRET=
